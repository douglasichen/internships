__pycache__/
*.pyc
data/
# out/all.json is tracked deliberately -- it's the full listing history,
# kept under git so that history survives scrapes/recomputes. Per-run CSV
# snapshots aren't (out/*.csv is just a point-in-time export of a run).
out/*
!out/all.json
.run.lock
.claude/scheduled_tasks.lock

# generated by the old sweep.py/scan_interns.py pipeline, superseded by internships/
new_swe_interns.csv
reports/
responses/
.DS_Store
