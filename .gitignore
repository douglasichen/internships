__pycache__/
*.pyc
data/
# out/all.json is tracked deliberately -- metadata listing history for the
# web UI, kept under git so that history survives scrapes/recomputes.
# Full apply-page HTML lives under out/descriptions/<id>.html.gz (gzip per
# listing id) -- local-only, not tracked. Legacy descriptions.json is also
# ignored. Per-run CSV snapshots aren't tracked either.
out/*
!out/all.json
.run.lock
.claude/scheduled_tasks.lock

# generated by the old sweep.py/scan_interns.py pipeline, superseded by internships/
new_swe_interns.csv
reports/
responses/
.DS_Store
