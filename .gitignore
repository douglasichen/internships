__pycache__/
*.pyc
data/
# out/all.json is tracked deliberately -- metadata listing history for the
# web UI, kept under git so that history survives scrapes/recomputes.
# Gitignored under out/* (local-only):
#   descriptions.json.gz  — {id: full apply-page HTML}
#   applied.json          — {id: ISO} applied checkbox marks
#   *.csv                 — per-run snapshots
# Legacy per-file out/descriptions/ and plain descriptions.json also ignored.
out/*
!out/all.json
.run.lock
.claude/scheduled_tasks.lock

# generated by the old sweep.py/scan_interns.py pipeline, superseded by internships/
new_swe_interns.csv
reports/
responses/
.DS_Store
